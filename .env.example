# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://price_app:price_app_pw@localhost:5435/price_comparison
POSTGRES_USER=price_app
POSTGRES_PASSWORD=price_app_pw
POSTGRES_DB=price_comparison

# ── Redis / Celery ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6381/0
CELERY_BROKER_URL=redis://localhost:6381/1
CELERY_RESULT_BACKEND=redis://localhost:6381/2

# ── App ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-in-production
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
API_V1_PREFIX=/api

# ── Data collection ──────────────────────────────────────────────────────
# true = use mock collectors (default; no live retailer access, fully demoable)
# false = use Playwright collectors against permitted retailers
MOCK_MODE=true
COLLECTOR_MAX_RESULTS_PER_RETAILER=5
COLLECTOR_REQUEST_TIMEOUT_MS=15000
COLLECTOR_MAX_RETRIES=2
COLLECTOR_MIN_DELAY_SECONDS=2
MAX_REVIEWS_PER_PRODUCT=100
PLAYWRIGHT_HEADLESS=true

# ── Matching thresholds ──────────────────────────────────────────────────
MATCH_THRESHOLD_MATCH=0.90
MATCH_THRESHOLD_POSSIBLE=0.75
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ── Optional LLM for review summarization ───────────────────────────────
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=

# ── Email (price alerts) ─────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=alerts@example.com

# ── Frontend ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
